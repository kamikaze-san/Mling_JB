# Environment Configuration for Lexsi Hackathon
# Copy to .env and fill in your values (DO NOT COMMIT .env)

# HuggingFace Token (for Cohere Aya models, Qwen Guard, Lexsi repos)
HF_TOKEN=your_huggingface_token_here

# Hardware & Compute Environment
DEVICE=auto                     # auto, cuda, mps, cpu
MAX_GPU_MEMORY=7.5GiB          # Laptop 8GB VRAM cap
USE_4BIT=true                  # 4-bit quantization for local 8GB inference
OFFLOAD_FOLDER=./cache/offload

# Pinned Local Judge Model
JUDGE_MODEL_ID=Qwen/Qwen3Guard-Gen-4B
JUDGE_DEVICE=auto
JUDGE_4BIT=true

# Attack Loop Internal Scorer (MUST be distinct from Judge)
SCORER_MODEL_ID=CohereForAI/aya-expanse-8b # Or local alternative / API
SCORER_DEVICE=auto

# Target Aya Models (Cohere Labs Track 2)
# Options: CohereForAI/aya-expanse-8b, CohereForAI/c4ai-aya-expanse-32b, etc.
TARGET_MODEL_ID=CohereForAI/aya-expanse-8b

# Optional API Keys for Expansion/Attacker Agents (if running hybrid cloud attacker)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Weights & Biases (optional)
WANDB_DISABLED=true
WANDB_PROJECT=lexsi-multilingual-redteaming

